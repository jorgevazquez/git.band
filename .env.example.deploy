# AWS Deployment Configuration
# Copy this to .env.local and fill in your values

# S3 bucket name where the site will be deployed
S3_BUCKET=git-band-site

# AWS region where the S3 bucket is located
AWS_REGION=us-east-1

# CloudFront distribution ID for cache invalidation (optional)
# If set, the deploy script will invalidate the distribution after upload
CLOUDFRONT_DISTRIBUTION_ID=

# AWS credentials (if not using AWS CLI/IAM profiles)
# It's recommended to use AWS CLI configured credentials instead
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Dry run mode - logs what would be uploaded without making changes
# DRY_RUN=true
